{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["chrome", "vitest/globals"]
  },
  "include": ["src", "popup", "tests", "vite.config.ts", "vite.content.config.ts", "vitest.config.ts"]
}
