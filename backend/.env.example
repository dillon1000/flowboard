DATABASE_PATH=db.sqlite
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SERVER_NAME=flowboard-server
SERVER_VERSION=0.1.0

# Transactional email is enabled only when all three values are present. The
# Worker owns templates and the Cloudflare Email Service binding; Vapor owns
# event creation and retries.
# NOTIFICATION_WORKER_URL=https://email.example.com/v1/notifications
# NOTIFICATION_SHARED_SECRET=replace-with-at-least-32-random-characters
# PUBLIC_APP_URL=https://app.example.com

# This short HTTPS surface is written to NFC tags. It can be a second custom
# domain on the same Railway service. The full URL must use fewer than 504 bytes.
# TAP_BASE_URL=https://tap.example.com/t

# Production requires all six values. Railway bucket credentials provide them.
# AWS_ENDPOINT_URL=https://storage.example
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_S3_BUCKET_NAME=replace-me
# AWS_DEFAULT_REGION=auto
# AWS_S3_URL_STYLE=virtual-host

# Set all six required values to enable the generic OAuth login.
# OAUTH_CLIENT_ID=flowboard
# OAUTH_CLIENT_SECRET=replace-me
# OAUTH_AUTHORIZATION_URL=https://provider.example/oauth/authorize
# OAUTH_TOKEN_URL=https://provider.example/oauth/token
# OAUTH_USERINFO_URL=https://provider.example/oauth/userinfo
# OAUTH_REDIRECT_URL=http://localhost:8080/oauth/callback

# These values adapt the generic provider without code changes.
# OAUTH_PROVIDER_ID=generic
# OAUTH_PROVIDER_NAME=Company SSO
# OAUTH_SCOPES=openid profile email
# OAUTH_TOKEN_AUTH_METHOD=client_secret_post
# OAUTH_USER_ID_FIELD=sub
# OAUTH_EMAIL_FIELD=email
# OAUTH_NAME_FIELD=name
# OAUTH_PICTURE_FIELD=picture
# OAUTH_EMAIL_VERIFIED_FIELD=email_verified
# OAUTH_REQUIRE_VERIFIED_EMAIL=true
