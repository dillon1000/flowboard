<!doctype html>
<html lang="en" data-controller="theme">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="csrf-token" content="#(csrfToken)" />
    <title>Log in · Flowboard</title>
    <link rel="icon" type="image/webp" href="/focalboard-fb-abbreviation-tp.webp" />
    <script>try{const t=localStorage.getItem('flowboard-theme');document.documentElement.dataset.theme=t==='dark'||t==='light'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}catch{}</script>
    #extend("partials/assets")
  </head>
  <body class="auth-page">
    <header class="auth-header">
      <a class="brand" href="/" aria-label="Focalboard home">
        <img class="brand-wordmark" src="/focalboard-wordmark.webp" alt="" width="112" height="15" />
      </a>
      <button
        class="icon-button"
        type="button"
        data-action="theme#toggle"
        aria-label="Change color theme"
        title="Change color theme"
      >
        <i class="theme-icon-dark" data-lucide="moon"></i>
        <i class="theme-icon-light" data-lucide="sun"></i>
        <span class="sr-only" data-theme-target="label">Use dark theme</span>
      </button>
    </header>

    <main class="auth-main auth-main-single">
      <div class="auth-form-pane">
      <section class="auth-card auth-card-minimal" aria-labelledby="page-title">
        <h1 id="page-title">Log in</h1>

        #if(error):
          <p class="error-message" role="alert">#(error)</p>
        #endif

        #if(oauthEnabled):
          <a class="button large block oauth-button" href="/oauth/start">
            <i data-lucide="log-in"></i>
            Continue with #(oauthProviderName)
          </a>
          <div class="auth-divider" aria-hidden="true"><span>or</span></div>
        #endif

        <form method="post" action="/login">
          <input type="hidden" name="_csrf" value="#(csrfToken)" />
          <div class="field">
            <label for="email">Email</label>
            <input
              class="input"
              id="email"
              type="email"
              name="email"
              value="#(email)"
              autocomplete="email"
              spellcheck="false"
              placeholder="you@example.com"
              required
              autofocus
            />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input
              class="input"
              id="password"
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="Enter your password"
              required
            />
          </div>
          <button class="button primary" type="submit">Log in</button>
        </form>

        <p class="auth-switch"><a href="/register">Create account</a></p>
      </section>
      #extend("partials/build-signature")
      </div>
    </main>
  </body>
</html>
