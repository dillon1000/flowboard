<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>Log In · Flowboard</title>
    <link rel="stylesheet" href="/auth.css" />
  </head>
  <body>
    <main class="auth-shell">
      <a class="auth-brand" href="/" aria-label="Flowboard home">
        <span class="brand-symbol" aria-hidden="true"></span>
        Flowboard
      </a>

      <section class="auth-card" aria-labelledby="page-title">
        <header>
          <h1 id="page-title">Log in to Flowboard</h1>
          <p>Use your account to open your workspace.</p>
        </header>

        #if(error):
          <p class="form-message">#(error)</p>
        #endif

        <form method="post" action="/login">
          <label>
            Email
            <input
              type="email"
              name="email"
              value="#(email)"
              autocomplete="email"
              spellcheck="false"
              placeholder="you@example.com"
              required
              autofocus
            />
          </label>
          <label>
            Password
            <input
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="Enter your password"
              required
            />
          </label>
          <button type="submit">Log In</button>
        </form>

        <p class="auth-switch">New to Flowboard? <a href="/register">Create an account</a></p>
      </section>
    </main>
  </body>
</html>
