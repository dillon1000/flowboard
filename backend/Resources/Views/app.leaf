<!doctype html>
<html lang="en" data-controller="theme completion">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="csrf-token" content="#(common.csrfToken)" />
    <meta name="turbo-refresh-method" content="morph" />
    <meta name="turbo-refresh-scroll" content="preserve" />
    <title>#(documentTitle)</title>
    <link rel="icon" type="image/webp" href="/focalboard-fb-abbreviation-tp.webp" />
    <script>try{const t=localStorage.getItem('flowboard-theme');document.documentElement.dataset.theme=t==='dark'||t==='light'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.dataset.sidebar=localStorage.getItem('flowboard-sidebar')==='collapsed'?'collapsed':'expanded'}catch{}</script>
    <link rel="stylesheet" href="/assets/index.css" />
    <script type="module" src="/assets/app.js"></script>
  </head>
  <body data-controller="sidebar" data-action="keydown@window->sidebar#shortcut">
    <div class="app-shell">
      #extend("partials/sidebar")

      <main class="workspace">
        #extend("partials/topbar")
        #extend("pages/overview")
        #extend("pages/tasks")
        #extend("pages/board")
        #extend("pages/task-detail")
        #extend("pages/settings")
        #extend("pages/board-settings")
      </main>
    </div>

    <div data-controller="task-preview">
      <div class="task-preview" data-task-preview-target="card" role="tooltip" hidden>
        <span class="preview-board" data-task-preview-target="board"></span>
        <h3 data-task-preview-target="title"></h3>
        <div class="preview-badges">
          <span class="badge status" data-task-preview-target="status"></span>
          <span class="badge" data-task-preview-target="priority"></span>
        </div>
        <p class="preview-body" data-task-preview-target="body"></p>
        <dl>
          <dt>Assignee</dt><dd data-task-preview-target="assignee"></dd>
          <dt>Due</dt><dd data-task-preview-target="due"></dd>
        </dl>
      </div>
    </div>

    <div
      class="toast"
      data-controller="toast"
      data-action="flowboard:notify@window->toast#show"
      role="status"
      hidden
    ><span data-toast-target="message"></span></div>
  </body>
</html>
