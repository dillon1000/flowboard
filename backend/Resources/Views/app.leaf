<!doctype html>
<html lang="en" data-controller="theme">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="csrf-token" content="#(common.csrfToken)" />
    <meta name="turbo-refresh-method" content="morph" />
    <meta name="turbo-refresh-scroll" content="preserve" />
    <title>#(documentTitle)</title>
    <link rel="icon" href="/favicon.svg" />
    <script>try{const t=localStorage.getItem('flowboard-theme');document.documentElement.dataset.theme=t==='dark'||t==='light'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}catch{}</script>
    <link rel="stylesheet" href="/assets/index.css" />
    <script type="module" src="/assets/app.js"></script>
  </head>
  <body data-controller="sidebar">
    <div class="app-shell">
      <aside class="sidebar" data-sidebar-target="panel">
        <div class="brand-row">
          <a class="brand" href="/app">
            <span class="brand-symbol" aria-hidden="true"></span>
            Flowboard
          </a>
          <button
            class="icon-button sidebar-close"
            type="button"
            aria-label="Close navigation"
            data-action="sidebar#close"
          ><i data-lucide="x"></i></button>
        </div>

        <nav class="main-nav" aria-label="Primary navigation">
          <a class="nav-link#if(isOverview): active#endif" href="/app">
            <i data-lucide="layout-dashboard"></i><span>Overview</span>
          </a>
          <a class="nav-link#if(isTasks): active#endif" href="/app/tasks">
            <i data-lucide="check-square"></i><span>All tasks</span>
          </a>
        </nav>

        <div class="boards-nav">
          <div class="nav-section-header" data-controller="dialog">
            <span>Boards</span>
            <button
              class="icon-button"
              type="button"
              aria-label="Create board"
              title="Create board"
              data-action="dialog#open"
            ><i data-lucide="plus"></i></button>

            <div
              class="dialog-layer"
              data-dialog-target="panel"
              data-action="click->dialog#backdrop keydown.esc@window->dialog#close"
              role="dialog"
              aria-modal="true"
              aria-labelledby="new-board-title"
              tabindex="-1"
              hidden
            >
              <form class="dialog" method="post" action="/app/boards">
                <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                <div class="dialog-header">
                  <div>
                    <h2 id="new-board-title">Create board</h2>
                    <p>Start with Board, Table, Calendar, and Gallery views.</p>
                  </div>
                  <button class="icon-button" type="button" data-action="dialog#close" aria-label="Close">
                    <i data-lucide="x"></i>
                  </button>
                </div>
                <div class="dialog-body">
                  <div class="field">
                    <label for="board-name">Name</label>
                    <input
                      class="input"
                      id="board-name"
                      name="name"
                      minlength="2"
                      maxlength="80"
                      required
                      data-dialog-target="initial"
                    />
                  </div>
                  <div class="field">
                    <label for="board-description">Description</label>
                    <textarea class="textarea" id="board-description" name="description" maxlength="500"></textarea>
                  </div>
                </div>
                <div class="dialog-footer">
                  <button class="button" type="button" data-action="dialog#close">Cancel</button>
                  <button class="button primary" type="submit">Create board</button>
                </div>
              </form>
            </div>
          </div>
          <nav aria-label="Boards">
            #for(navBoard in common.boards):
              #if(!navBoard.isArchived):
                <a class="nav-link" href="#(navBoard.href)">
                  <i data-lucide="folder"></i>
                  <span>#(navBoard.name)</span>
                  <small>#(navBoard.taskCount)</small>
                </a>
              #endif
            #endfor
          </nav>
        </div>

        <div class="sidebar-spacer"></div>
        <nav class="settings-nav">
          <a class="nav-link#if(isSettings): active#endif" href="/app/settings">
            <i data-lucide="settings"></i><span>Settings</span>
          </a>
        </nav>
        <a class="user-row" href="/app/settings">
          <span class="avatar">#(common.userInitials)</span>
          <span>
            <strong>#(common.userName)</strong>
            <small>#(common.userEmail)</small>
          </span>
        </a>
      </aside>

      <button
        class="sidebar-scrim"
        type="button"
        aria-label="Close navigation"
        data-sidebar-target="scrim"
        data-action="sidebar#close"
        hidden
      ></button>

      <main class="workspace">
        <header class="topbar">
          <button class="icon-button menu-button" type="button" data-action="sidebar#open" aria-label="Open navigation">
            <i data-lucide="menu"></i>
          </button>
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/app">Workspace</a>
            <span aria-hidden="true">/</span>
            <span>#(pageTitle)</span>
          </nav>
          <div class="topbar-actions">
            <form
              class="search-control"
              method="get"
              action="/app/tasks"
              role="search"
              data-controller="search"
              data-action="keydown@window->search#shortcut"
            >
              <i data-lucide="search"></i>
              <input name="q" aria-label="Search tasks" placeholder="Search tasks" data-search-target="input" />
              <kbd>⌘ K</kbd>
            </form>
            <button
              class="icon-button theme-button"
              type="button"
              data-action="theme#toggle"
              aria-label="Change color theme"
              title="Change color theme"
            >
              <i class="theme-icon-dark" data-lucide="moon"></i>
              <i class="theme-icon-light" data-lucide="sun"></i>
              <span class="sr-only" data-theme-target="label">Use dark theme</span>
            </button>
          </div>
        </header>

        #if(isOverview):
          <div class="page">
            <header class="page-header">
              <div class="page-title">
                <h1>Overview</h1>
                <p>Boards, deadlines, and recent work in one place.</p>
              </div>
            </header>

            <section class="stats" aria-label="Workspace summary">
              <div class="stat"><span>Open tasks</span><strong>#(overview.totalTasks)</strong></div>
              <div class="stat"><span>Completed</span><strong>#(overview.completedTasks)</strong></div>
              <div class="stat"><span>With due dates</span><strong>#(overview.dueTasks)</strong></div>
              <div class="stat"><span>Active boards</span><strong>#(overview.boardCount)</strong></div>
            </section>

            <section class="section">
              <div class="section-heading"><h2>Boards</h2></div>
              <div class="board-list">
                #for(navBoard in common.boards):
                  #if(!navBoard.isArchived):
                    <a class="board-card" href="#(navBoard.href)">
                      <h3>#(navBoard.name)</h3>
                      <p>#(navBoard.description)</p>
                      <span class="board-card-meta">
                        <span>#(navBoard.taskCount) tasks</span>
                        <span>#(navBoard.completedCount) done</span>
                      </span>
                    </a>
                  #endif
                #endfor
              </div>
            </section>

            <section class="section">
              <div class="section-heading">
                <h2>Recent tasks</h2>
                <a class="button ghost small" href="/app/tasks">View all</a>
              </div>
              #if(overview.hasRecentTasks):
                <div class="panel">
                  #for(task in overview.recentTasks):
                    <a class="panel-row" href="#(task.href)">
                      <span class="badge priority-#(task.priorityValue)">#(task.priorityName)</span>
                      <span class="panel-row-main">
                        <strong>#(task.title)</strong>
                        <span>#(task.boardName) · #(task.statusName)</span>
                      </span>
                      <span class="badge">#(task.updatedDisplay)</span>
                    </a>
                  #endfor
                </div>
              #else:
                <div class="empty-state">
                  <div><h2>No tasks yet</h2><p>Open a board and create the first task.</p></div>
                </div>
              #endif
            </section>
          </div>
        #endif

        #if(isTasks):
          <div class="page">
            <header class="page-header">
              <div class="page-title">
                <h1>#if(tasks.query):Search results#else:All tasks#endif</h1>
                <p>#if(tasks.query):Tasks matching “#(tasks.query)”.#else:Every active task you can access.#endif</p>
              </div>
            </header>
            #if(tasks.hasTasks):
              <div class="table-wrap">
                <table class="data-table">
                  <thead><tr><th>Task</th><th>Board</th><th>Status</th><th>Priority</th><th>Assignee</th><th>Due</th></tr></thead>
                  <tbody>
                    #for(task in tasks.tasks):
                      <tr>
                        <td><a href="#(task.href)">#(task.title)</a></td>
                        <td>#(task.boardName)</td>
                        <td><span class="badge">#(task.statusName)</span></td>
                        <td><span class="badge priority-#(task.priorityValue)">#(task.priorityName)</span></td>
                        <td>#(task.assigneeName)</td>
                        <td>#(task.dueDisplay)</td>
                      </tr>
                    #endfor
                  </tbody>
                </table>
              </div>
            #else:
              <div class="empty-state">
                <div><h2>No tasks found</h2><p>Try a different search, or create a task from a board.</p></div>
              </div>
            #endif
          </div>
        #endif

        #if(isBoard):
          <div class="page">
            <header class="page-header">
              <div class="page-title">
                <h1>#(board.name)</h1>
                <p>#if(board.description):#(board.description)#else:Shared as #(board.role).#endif</p>
              </div>
              <div class="page-actions">
                <a class="button" href="/app/boards/#(board.id)/settings"><i data-lucide="settings"></i>Board settings</a>
                #if(board.canEdit):
                  <div data-controller="dialog">
                    <button class="button primary" type="button" data-action="dialog#open">
                      <i data-lucide="plus"></i>New task
                    </button>
                    <div
                      class="dialog-layer"
                      data-dialog-target="panel"
                      data-action="click->dialog#backdrop keydown.esc@window->dialog#close"
                      role="dialog"
                      aria-modal="true"
                      aria-labelledby="new-task-title"
                      tabindex="-1"
                      hidden
                    >
                      <form class="dialog wide" method="post" action="/app/tasks">
                        <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                        <input type="hidden" name="boardID" value="#(board.id)" />
                        <input type="hidden" name="returnTo" value="#(board.activeView.href)" />
                        <div class="dialog-header">
                          <div><h2 id="new-task-title">Create task</h2><p>#if(board.hasDefaultTemplate):Using the #(board.defaultTemplateName) template.#else:Add the work, then refine its details.#endif</p></div>
                          <button class="icon-button" type="button" data-action="dialog#close" aria-label="Close"><i data-lucide="x"></i></button>
                        </div>
                        <div class="dialog-body">
                          <div class="form-grid">
                            <div class="field wide">
                              <label for="new-task-name">Title</label>
                              <input class="input" id="new-task-name" name="title" value="#(board.newTaskTitle)" maxlength="120" required data-dialog-target="initial" />
                            </div>
                            <div class="field wide">
                              <label for="new-task-description">Description</label>
                              <textarea class="textarea" id="new-task-description" name="description" maxlength="5000">#(board.newTaskDescription)</textarea>
                            </div>
                            <div class="field">
                              <span class="field-label">Status</span>
                              <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                                <input data-menu-target="input" type="hidden" name="status" value="#(board.newTaskStatus)" />
                                <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                                  <span data-menu-target="value">#(board.newTaskStatusName)</span><i data-lucide="chevron-down"></i>
                                </button>
                                <div class="menu-panel" data-menu-target="panel" role="listbox" hidden>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="backlog" data-label="Backlog" aria-selected="#(board.newTaskIsBacklog)">Backlog</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="in_progress" data-label="In progress" aria-selected="#(board.newTaskIsInProgress)">In progress</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="review" data-label="Review" aria-selected="#(board.newTaskIsReview)">Review</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="done" data-label="Done" aria-selected="#(board.newTaskIsDone)">Done</button>
                                </div>
                              </div>
                            </div>
                            <div class="field">
                              <span class="field-label">Priority</span>
                              <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                                <input data-menu-target="input" type="hidden" name="priority" value="#(board.newTaskPriority)" />
                                <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                                  <span data-menu-target="value">#(board.newTaskPriorityName)</span><i data-lucide="chevron-down"></i>
                                </button>
                                <div class="menu-panel" data-menu-target="panel" role="listbox" hidden>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="low" data-label="Low" aria-selected="#(board.newTaskIsLowPriority)">Low</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="medium" data-label="Medium" aria-selected="#(board.newTaskIsMediumPriority)">Medium</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="high" data-label="High" aria-selected="#(board.newTaskIsHighPriority)">High</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="urgent" data-label="Urgent" aria-selected="#(board.newTaskIsUrgentPriority)">Urgent</button>
                                </div>
                              </div>
                            </div>
                            <div class="field" data-controller="date-picker">
                              <label for="new-task-start">Start date</label>
                              <input class="input" id="new-task-start" name="startAt" data-date-picker-target="input" />
                            </div>
                            <div class="field" data-controller="date-picker">
                              <label for="new-task-due">Due date</label>
                              <input class="input" id="new-task-due" name="dueAt" data-date-picker-target="input" />
                            </div>
                            <div class="field wide">
                              <label for="new-task-labels">Labels</label>
                              <input class="input" id="new-task-labels" name="labels" value="#(board.newTaskLabels)" placeholder="Design, Launch" />
                            </div>
                          </div>
                        </div>
                        <div class="dialog-footer">
                          <button class="button" type="button" data-action="dialog#close">Cancel</button>
                          <button class="button primary" type="submit">Create task</button>
                        </div>
                      </form>
                    </div>
                  </div>
                #endif
              </div>
            </header>

            <nav class="board-toolbar" aria-label="Board views">
              #for(view in board.views):
                <a class="view-tab#if(view.isActive): active#endif" href="#(view.href)">
                  <i data-lucide="#(view.icon)"></i>#(view.name)
                </a>
              #endfor
              <span class="toolbar-spacer"></span>
              <span class="badge">Group: #(board.groupByName)</span>
              #if(board.hasFilters):<span class="badge"><i data-lucide="filter"></i>#(board.filterSummary)</span>#endif
              #if(board.hasSorts):<span class="badge"><i data-lucide="arrow-down-up"></i>#(board.sortSummary)</span>#endif
              <a class="button ghost small" href="/app/boards/#(board.id)/settings"><i data-lucide="settings"></i>Configure</a>
            </nav>

            #if(board.activeView.isBoard):
              <div class="kanban" data-controller="board" data-board-editable-value="#(board.canDrag)">
                #for(column in board.columns):
                  <section class="kanban-column">
                    <header class="column-header">
                      <span class="column-dot #(column.dotClass)"></span>
                      <strong>#(column.name)</strong>
                      <span>#(column.count)</span>
                    </header>
                    <div class="column-tasks" data-board-target="column" data-status="#(column.value)">
                      #for(task in column.tasks):
                        #extend("partials/task-card", task)
                      #endfor
                    </div>
                  </section>
                #endfor
              </div>
            #endif

            #if(board.activeView.isTable):
              #if(board.hasTasks):
                <div class="table-wrap">
                  <table class="data-table">
                    <thead><tr><th>Task</th><th>Status</th><th>Priority</th><th>Assignee</th><th>Start</th><th>Due</th></tr></thead>
                    <tbody>
                      #for(task in board.tasks):
                        <tr>
                          <td><a href="#(task.href)">#(task.title)</a></td>
                          <td><span class="badge">#(task.statusName)</span></td>
                          <td><span class="badge priority-#(task.priorityValue)">#(task.priorityName)</span></td>
                          <td>#(task.assigneeName)</td>
                          <td>#(task.startDisplay)</td>
                          <td>#(task.dueDisplay)</td>
                        </tr>
                      #endfor
                    </tbody>
                  </table>
                </div>
              #else:
                <div class="empty-state"><div><h2>No tasks in this view</h2><p>Create a task or change this view’s filters.</p></div></div>
              #endif
            #endif

            #if(board.activeView.isCalendar):
              <div class="calendar-shell">
                <div class="calendar-toolbar">
                  <div class="calendar-navigation">
                    <a class="icon-button" href="#(board.previousMonthHref)" aria-label="Previous month"><i data-lucide="chevron-left"></i></a>
                    <h2>#(board.calendarMonthLabel)</h2>
                    <a class="icon-button" href="#(board.nextMonthHref)" aria-label="Next month"><i data-lucide="chevron-right"></i></a>
                  </div>
                  <a class="button secondary small" href="#(board.todayMonthHref)">Today</a>
                </div>
                <div class="calendar-weekdays"><div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div></div>
                <div class="calendar-grid">
                  #for(day in board.calendarDays):
                    <div class="calendar-day#if(day.isMuted): muted#endif">
                      <span>#(day.day)</span>
                      #for(task in day.tasks):
                        <a class="calendar-task" href="#(task.href)">#(task.title)</a>
                      #endfor
                    </div>
                  #endfor
                </div>
              </div>
            #endif

            #if(board.activeView.isGallery):
              #if(board.hasTasks):
                <div class="gallery">
                  #for(task in board.tasks):
                    <a class="gallery-card" href="#(task.href)">
                      <h3>#(task.title)</h3>
                      <p>#if(task.hasDescription):#(task.description)#else:No description.#endif</p>
                      <div class="task-meta">
                        <span class="badge">#(task.statusName)</span>
                        <span class="badge priority-#(task.priorityValue)">#(task.priorityName)</span>
                      </div>
                    </a>
                  #endfor
                </div>
              #else:
                <div class="empty-state"><div><h2>No tasks in this view</h2><p>Create a task or change this view’s filters.</p></div></div>
              #endif
            #endif
          </div>
        #endif

        #if(isTaskDetail):
          <div class="page narrow">
            <header class="page-header">
              <div class="page-title">
                <a class="button ghost small" href="#(taskDetail.boardHref)">← #(taskDetail.boardName)</a>
              </div>
              <div class="page-actions">
                <form method="post" action="/app/tasks/#(taskDetail.task.id)/follow">
                  <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                  <button class="button" type="submit">
                    <i data-lucide="bell"></i>
                    #if(taskDetail.isFollowing):Unfollow#else:Follow#endif
                    <span class="badge">#(taskDetail.followerCount)</span>
                  </button>
                </form>
                #if(taskDetail.canEdit):
                  <div data-controller="dialog">
                    <button class="button" type="button" data-action="dialog#open">Edit task</button>
                    <div
                      class="dialog-layer"
                      data-dialog-target="panel"
                      data-action="click->dialog#backdrop keydown.esc@window->dialog#close"
                      role="dialog"
                      aria-modal="true"
                      aria-labelledby="edit-task-title"
                      tabindex="-1"
                      hidden
                    >
                      <form class="dialog wide" method="post" action="/app/tasks/#(taskDetail.task.id)/update">
                        <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                        <div class="dialog-header">
                          <div><h2 id="edit-task-title">Edit task</h2><p>Update the task and its schedule.</p></div>
                          <button class="icon-button" type="button" data-action="dialog#close" aria-label="Close"><i data-lucide="x"></i></button>
                        </div>
                        <div class="dialog-body">
                          <div class="form-grid">
                            <div class="field wide">
                              <label for="edit-task-name">Title</label>
                              <input class="input" id="edit-task-name" name="title" value="#(taskDetail.task.title)" maxlength="120" required data-dialog-target="initial" />
                            </div>
                            <div class="field wide">
                              <label for="edit-task-description">Description</label>
                              <textarea class="textarea" id="edit-task-description" name="description" maxlength="5000">#(taskDetail.task.description)</textarea>
                            </div>
                            <div class="field">
                              <span class="field-label">Status</span>
                              <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                                <input data-menu-target="input" type="hidden" name="status" value="#(taskDetail.task.statusValue)" />
                                <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                                  <span data-menu-target="value">#(taskDetail.task.statusName)</span><i data-lucide="chevron-down"></i>
                                </button>
                                <div class="menu-panel" data-menu-target="panel" role="listbox" hidden>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="backlog" data-label="Backlog" aria-selected="#(taskDetail.task.isBacklog)">Backlog</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="in_progress" data-label="In progress" aria-selected="#(taskDetail.task.isInProgress)">In progress</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="review" data-label="Review" aria-selected="#(taskDetail.task.isReview)">Review</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="done" data-label="Done" aria-selected="#(taskDetail.task.isDone)">Done</button>
                                </div>
                              </div>
                            </div>
                            <div class="field">
                              <span class="field-label">Priority</span>
                              <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                                <input data-menu-target="input" type="hidden" name="priority" value="#(taskDetail.task.priorityValue)" />
                                <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                                  <span data-menu-target="value">#(taskDetail.task.priorityName)</span><i data-lucide="chevron-down"></i>
                                </button>
                                <div class="menu-panel" data-menu-target="panel" role="listbox" hidden>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="low" data-label="Low" aria-selected="#(taskDetail.task.isLowPriority)">Low</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="medium" data-label="Medium" aria-selected="#(taskDetail.task.isMediumPriority)">Medium</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="high" data-label="High" aria-selected="#(taskDetail.task.isHighPriority)">High</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="urgent" data-label="Urgent" aria-selected="#(taskDetail.task.isUrgentPriority)">Urgent</button>
                                </div>
                              </div>
                            </div>
                            <div class="field wide">
                              <span class="field-label">Assignee</span>
                              <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                                <input data-menu-target="input" type="hidden" name="assigneeID" value="#(taskDetail.task.assigneeID)" />
                                <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                                  <span data-menu-target="value">#(taskDetail.task.assigneeName)</span><i data-lucide="chevron-down"></i>
                                </button>
                                <div class="menu-panel" data-menu-target="panel" role="listbox" hidden>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="" data-label="Unassigned" aria-selected="#if(taskDetail.task.hasAssignee):false#else:true#endif">Unassigned</button>
                                  #for(member in taskDetail.members):
                                    <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="#(member.id)" data-label="#(member.name)" aria-selected="#(member.isSelected)">#(member.name) · #(member.email)</button>
                                  #endfor
                                </div>
                              </div>
                            </div>
                            <div class="field" data-controller="date-picker">
                              <label for="edit-task-start">Start date</label>
                              <input class="input" id="edit-task-start" name="startAt" value="#(taskDetail.task.startInput)" data-date-picker-target="input" />
                            </div>
                            <div class="field" data-controller="date-picker">
                              <label for="edit-task-due">Due date</label>
                              <input class="input" id="edit-task-due" name="dueAt" value="#(taskDetail.task.dueInput)" data-date-picker-target="input" />
                            </div>
                            <div class="field wide">
                              <label for="edit-task-labels">Labels</label>
                              <input class="input" id="edit-task-labels" name="labels" value="#(taskDetail.task.labelsJoined)" />
                            </div>
                          </div>
                        </div>
                        <div class="dialog-footer">
                          <button class="button" type="button" data-action="dialog#close">Cancel</button>
                          <button class="button primary" type="submit">Save changes</button>
                        </div>
                      </form>
                    </div>
                  </div>
                #endif
              </div>
            </header>

            <div class="split-layout">
              <article class="task-detail">
                <h1>#(taskDetail.task.title)</h1>
                <div class="task-description">#if(taskDetail.task.hasDescription):#(taskDetail.task.description)#else:No description yet.#endif</div>

                <section class="section">
                  <div class="section-heading"><h2>Checklist</h2></div>
                  <div class="checklist">
                    #for(item in taskDetail.checklist):
                      <form class="checklist-item" method="post" action="/app/checklist/#(item.id)/toggle">
                        <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                        <button class="custom-checkbox#if(item.isCompleted): checked#endif" type="submit" aria-label="Toggle checklist item">
                          <i data-lucide="check"></i>
                        </button>
                        <span>#(item.title)</span>
                      </form>
                    #endfor
                    #if(taskDetail.canEdit):
                      <form class="panel-row" method="post" action="/app/tasks/#(taskDetail.task.id)/checklist">
                        <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                        <input class="input" name="title" placeholder="Add checklist item" maxlength="200" required />
                        <button class="button small" type="submit">Add</button>
                      </form>
                    #endif
                  </div>
                </section>

                <section class="section">
                  <div class="section-heading"><h2>Attachments</h2></div>
                  <div class="panel">
                    #for(attachment in taskDetail.attachments):
                      <div class="panel-row">
                        <i data-lucide="paperclip"></i>
                        <span class="panel-row-main">
                          <strong><a href="#(attachment.href)">#(attachment.fileName)</a></strong>
                          <span>#(attachment.sizeDisplay)</span>
                        </span>
                      </div>
                    #endfor
                    #if(taskDetail.canEdit):
                      <form class="panel-row" method="post" action="/app/tasks/#(taskDetail.task.id)/attachments" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                        <label class="button small">
                          <i data-lucide="upload"></i>Choose file
                          <input class="sr-only" type="file" name="file" required />
                        </label>
                        <button class="button small" type="submit">Upload</button>
                      </form>
                    #endif
                  </div>
                </section>

                <section class="section">
                  <div class="section-heading"><h2>Comments</h2></div>
                  <div class="panel">
                    #for(comment in taskDetail.comments):
                      <div class="comment panel-row">
                        <span class="avatar">#(comment.authorInitials)</span>
                        <div>
                          <div class="comment-meta">#(comment.authorName) · #(comment.createdDisplay)</div>
                          <div class="comment-body">#(comment.body)</div>
                          #if(comment.canDelete):
                            <form method="post" action="/app/comments/#(comment.id)/delete">
                              <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                              <button class="button ghost small" type="submit">Delete</button>
                            </form>
                          #endif
                        </div>
                      </div>
                    #endfor
                    #if(taskDetail.canComment):
                      <form class="dialog-body" method="post" action="/app/tasks/#(taskDetail.task.id)/comments">
                        <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                        <div class="field">
                          <label for="new-comment">Add a comment</label>
                          <textarea class="textarea" id="new-comment" name="body" maxlength="4000" required></textarea>
                        </div>
                        <div class="form-actions"><button class="button primary" type="submit">Comment</button></div>
                      </form>
                    #endif
                  </div>
                </section>
              </article>

              <aside>
                <div class="property-list">
                  <div class="property-row"><span>Status</span><span class="badge">#(taskDetail.task.statusName)</span></div>
                  <div class="property-row"><span>Priority</span><span class="badge priority-#(taskDetail.task.priorityValue)">#(taskDetail.task.priorityName)</span></div>
                  <div class="property-row"><span>Assignee</span><span>#(taskDetail.task.assigneeName)</span></div>
                  <div class="property-row"><span>Start</span><span>#(taskDetail.task.startDisplay)</span></div>
                  <div class="property-row"><span>Due</span><span>#(taskDetail.task.dueDisplay)</span></div>
                  #for(property in taskDetail.properties):
                    <div class="property-row"><span>#(property.name)</span><span>#(property.value)</span></div>
                  #endfor
                </div>
                #if(taskDetail.canEdit):
                  #if(taskDetail.hasProperties):
                    <section class="section">
                      <div class="section-heading"><h2>Custom fields</h2></div>
                      <form class="panel dialog-body" method="post" action="/app/tasks/#(taskDetail.task.id)/properties">
                        <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                        #for(property in taskDetail.properties):
                          <div class="field">
                            <label for="property-#(property.id)">#(property.name)</label>
                            <input class="input" id="property-#(property.id)" name="property-#(property.id)" value="#(property.inputValue)" />
                          </div>
                        #endfor
                        <div class="form-actions"><button class="button small" type="submit">Save fields</button></div>
                      </form>
                    </section>
                  #endif
                  <section class="section">
                    <div class="panel danger-zone">
                      <div class="panel-row">
                        <span class="panel-row-main"><strong>#if(taskDetail.task.isArchived):Restore task#else:Archive task#endif</strong><span>Archived tasks leave active views.</span></span>
                        <form method="post" action="/app/tasks/#(taskDetail.task.id)/archive">
                          <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                          <button class="button small" type="submit">#if(taskDetail.task.isArchived):Restore#else:Archive#endif</button>
                        </form>
                      </div>
                      <div class="panel-row" data-controller="dialog">
                        <span class="panel-row-main"><strong>Delete task</strong><span>Permanently remove this task.</span></span>
                        <button class="button danger small" type="button" data-action="dialog#open">Delete</button>
                        <div
                          class="dialog-layer"
                          data-dialog-target="panel"
                          data-action="click->dialog#backdrop keydown.esc@window->dialog#close"
                          role="dialog"
                          aria-modal="true"
                          aria-labelledby="delete-task-title"
                          tabindex="-1"
                          hidden
                        >
                          <form class="dialog" method="post" action="/app/tasks/#(taskDetail.task.id)/delete">
                            <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                            <div class="dialog-header"><div><h2 id="delete-task-title">Delete this task?</h2><p>This action cannot be undone.</p></div></div>
                            <div class="dialog-footer">
                              <button class="button" type="button" data-action="dialog#close">Cancel</button>
                              <button class="button danger" type="submit">Delete task</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  </section>
                #endif
              </aside>
            </div>
          </div>
        #endif

        #if(isSettings):
          <div class="page narrow">
            <header class="page-header">
              <div class="page-title"><h1>Settings</h1><p>Manage your account and workspace preferences.</p></div>
            </header>
            <div class="settings-grid">
              <nav class="settings-menu">
                <a class="nav-link active" href="/app/settings"><i data-lucide="user"></i>Profile</a>
              </nav>
              <div class="settings-content">
                <section class="section">
                  <div class="section-heading"><h2>Profile</h2></div>
                  <form class="panel dialog-body" method="post" action="/app/settings/profile">
                    <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                    <div class="field">
                      <label for="profile-name">Name</label>
                      <input class="input" id="profile-name" name="name" value="#(common.userName)" minlength="2" maxlength="80" required />
                    </div>
                    <div class="field">
                      <label for="profile-email">Email</label>
                      <input class="input" id="profile-email" value="#(common.userEmail)" disabled />
                      <span class="field-help">Email changes are not available in this build.</span>
                    </div>
                    <div class="form-actions"><button class="button primary" type="submit">Save profile</button></div>
                  </form>
                </section>
                <section class="section">
                  <div class="section-heading"><h2>Session</h2></div>
                  <div class="panel">
                    <div class="panel-row">
                      <span class="panel-row-main"><strong>Log out</strong><span>End this browser session.</span></span>
                      <form method="post" action="/logout">
                        <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                        <button class="button" type="submit"><i data-lucide="log-out"></i>Log out</button>
                      </form>
                    </div>
                  </div>
                </section>
              </div>
            </div>
          </div>
        #endif

        #if(isBoardSettings):
          <div class="page narrow">
            <header class="page-header">
              <div class="page-title">
                <h1>#(boardSettings.name) settings</h1>
                <p>Configure views, fields, templates, sharing, and data.</p>
              </div>
              <a class="button" href="#(boardSettings.firstViewHref)">Back to board</a>
            </header>

            <section class="section">
              <div class="section-heading"><h2>General</h2></div>
              <form class="panel dialog-body" method="post" action="/app/boards/#(boardSettings.id)/update">
                <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                <div class="field">
                  <label for="settings-board-name">Name</label>
                  <input class="input" id="settings-board-name" name="name" value="#(boardSettings.name)" minlength="2" maxlength="80" required />
                </div>
                <div class="field">
                  <label for="settings-board-description">Description</label>
                  <textarea class="textarea" id="settings-board-description" name="description" maxlength="500">#(boardSettings.description)</textarea>
                </div>
                <div class="form-actions"><button class="button primary" type="submit">Save board</button></div>
              </form>
            </section>

            <section class="section">
              <div class="section-heading"><div><h2>Views</h2><p>Saved layouts can keep their own filters and sorting.</p></div></div>
              <div class="panel">
                #for(view in boardSettings.views):
                  <div class="panel-row">
                    <i data-lucide="columns-3"></i>
                    <span class="panel-row-main"><strong>#(view.name)</strong><span>#(view.typeName) · Grouped by #(view.groupByName)</span></span>
                    <div data-controller="dialog">
                      <button class="button small" type="button" data-action="dialog#open">Configure</button>
                      <div
                        class="dialog-layer"
                        data-dialog-target="panel"
                        data-action="click->dialog#backdrop keydown.esc@window->dialog#close"
                        role="dialog"
                        aria-modal="true"
                        aria-labelledby="configure-view-#(view.id)"
                        tabindex="-1"
                        hidden
                      >
                        <form class="dialog" method="post" action="/app/boards/#(boardSettings.id)/views/#(view.id)/configure">
                          <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                          <div class="dialog-header">
                            <div><h2 id="configure-view-#(view.id)">Configure #(view.name)</h2><p>Set grouping, one filter, and one sort rule.</p></div>
                            <button class="icon-button" type="button" data-action="dialog#close" aria-label="Close"><i data-lucide="x"></i></button>
                          </div>
                          <div class="dialog-body">
                            <div class="field">
                              <span class="field-label">Group board cards by</span>
                              <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                                <input data-menu-target="input" type="hidden" name="groupBy" value="#(view.groupBy)" />
                                <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                                  <span data-menu-target="value">#(view.groupByName)</span><i data-lucide="chevron-down"></i>
                                </button>
                                <div class="menu-panel" data-menu-target="panel" role="listbox" hidden>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="status" data-label="Status" aria-selected="#(view.isGroupedByStatus)">Status</button>
                                  <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="priority" data-label="Priority" aria-selected="#(view.isGroupedByPriority)">Priority</button>
                                </div>
                              </div>
                            </div>
                            <div class="form-grid">
                              <div class="field">
                                <label for="filter-field-#(view.id)">Filter field</label>
                                <input class="input" id="filter-field-#(view.id)" name="filterField" value="#(view.filterField)" placeholder="status, priority, or label" />
                              </div>
                              <div class="field">
                                <label for="filter-value-#(view.id)">Filter value</label>
                                <input class="input" id="filter-value-#(view.id)" name="filterValue" value="#(view.filterValue)" placeholder="review" />
                              </div>
                              <div class="field">
                                <label for="sort-field-#(view.id)">Sort field</label>
                                <input class="input" id="sort-field-#(view.id)" name="sortField" value="#(view.sortField)" placeholder="title, due_at, or priority" />
                              </div>
                              <div class="field">
                                <span class="field-label">Sort direction</span>
                                <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                                  <input data-menu-target="input" type="hidden" name="sortDirection" value="#(view.sortDirection)" />
                                  <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                                    <span data-menu-target="value">#(view.sortDirection)</span><i data-lucide="chevron-down"></i>
                                  </button>
                                  <div class="menu-panel" data-menu-target="panel" role="listbox" hidden>
                                    <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="ascending" data-label="Ascending" aria-selected="#(view.isAscending)">Ascending</button>
                                    <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="descending" data-label="Descending" aria-selected="#(view.isDescending)">Descending</button>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                          <div class="dialog-footer">
                            <button class="button" type="button" data-action="dialog#close">Cancel</button>
                            <button class="button primary" type="submit">Save view</button>
                          </div>
                        </form>
                      </div>
                    </div>
                    <form method="post" action="/app/boards/#(boardSettings.id)/views/#(view.id)/delete">
                      <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                      <button class="icon-button" type="submit" aria-label="Delete #(view.name)" title="Delete view"><i data-lucide="x"></i></button>
                    </form>
                  </div>
                #endfor
                <form class="panel-row" method="post" action="/app/boards/#(boardSettings.id)/views">
                  <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                  <input class="input" name="name" placeholder="View name" maxlength="60" required />
                  <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                    <input data-menu-target="input" type="hidden" name="type" value="board" />
                    <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                      <span data-menu-target="value">Board</span><i data-lucide="chevron-down"></i>
                    </button>
                    <div class="menu-panel right" data-menu-target="panel" role="listbox" hidden>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="board" data-label="Board" aria-selected="true">Board</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="table" data-label="Table" aria-selected="false">Table</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="calendar" data-label="Calendar" aria-selected="false">Calendar</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="gallery" data-label="Gallery" aria-selected="false">Gallery</button>
                    </div>
                  </div>
                  <button class="button small" type="submit">Add view</button>
                </form>
              </div>
            </section>

            <section class="section">
              <div class="section-heading"><div><h2>Custom fields</h2><p>Add typed fields to every task on this board.</p></div></div>
              <div class="panel">
                #for(property in boardSettings.properties):
                  <div class="panel-row">
                    <i data-lucide="tag"></i>
                    <span class="panel-row-main"><strong>#(property.name)</strong><span>#(property.typeName)</span></span>
                  </div>
                #endfor
                <form class="panel-row" method="post" action="/app/boards/#(boardSettings.id)/properties">
                  <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                  <input class="input" name="name" placeholder="Field name" maxlength="60" required />
                  <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                    <input data-menu-target="input" type="hidden" name="type" value="text" />
                    <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                      <span data-menu-target="value">Text</span><i data-lucide="chevron-down"></i>
                    </button>
                    <div class="menu-panel right" data-menu-target="panel" role="listbox" hidden>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="text" data-label="Text" aria-selected="true">Text</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="number" data-label="Number" aria-selected="false">Number</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="select" data-label="Select" aria-selected="false">Select</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="multi_select" data-label="Multi-select" aria-selected="false">Multi-select</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="date" data-label="Date" aria-selected="false">Date</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="checkbox" data-label="Checkbox" aria-selected="false">Checkbox</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="url" data-label="URL" aria-selected="false">URL</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="email" data-label="Email" aria-selected="false">Email</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="person" data-label="Person" aria-selected="false">Person</button>
                    </div>
                  </div>
                  <button class="button small" type="submit">Add field</button>
                </form>
              </div>
            </section>

            <section class="section">
              <div class="section-heading"><div><h2>Members</h2><p>Viewer, Commenter, Editor, and Admin roles control access.</p></div></div>
              <div class="panel">
                <div class="panel-row">
                  <span class="avatar">#(boardSettings.ownerInitials)</span>
                  <span class="panel-row-main"><strong>#(boardSettings.ownerName)</strong><span>#(boardSettings.ownerEmail)</span></span>
                  <span class="badge">Owner</span>
                </div>
                #for(member in boardSettings.members):
                  <div class="panel-row">
                    <span class="avatar">#(member.initials)</span>
                    <span class="panel-row-main"><strong>#(member.name)</strong><span>#(member.email)</span></span>
                    <span class="badge">#(member.role)</span>
                    <form method="post" action="/app/boards/#(boardSettings.id)/members/#(member.id)/remove">
                      <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                      <button class="icon-button" type="submit" aria-label="Remove #(member.name)" title="Remove member"><i data-lucide="x"></i></button>
                    </form>
                  </div>
                #endfor
                <form class="panel-row" method="post" action="/app/boards/#(boardSettings.id)/members">
                  <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                  <input class="input" type="email" name="email" placeholder="Member email" required />
                  <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                    <input data-menu-target="input" type="hidden" name="role" value="editor" />
                    <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                      <span data-menu-target="value">Editor</span><i data-lucide="chevron-down"></i>
                    </button>
                    <div class="menu-panel right" data-menu-target="panel" role="listbox" hidden>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="viewer" data-label="Viewer" aria-selected="false">Viewer</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="commenter" data-label="Commenter" aria-selected="false">Commenter</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="editor" data-label="Editor" aria-selected="true">Editor</button>
                      <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="admin" data-label="Admin" aria-selected="false">Admin</button>
                    </div>
                  </div>
                  <button class="button small" type="submit">Share</button>
                </form>
              </div>
            </section>

            <section class="section">
              <div class="section-heading"><div><h2>Task templates</h2><p>Reuse common task structure.</p></div></div>
              <div class="panel">
                #for(template in boardSettings.templates):
                  <div class="panel-row">
                    <i data-lucide="copy"></i>
                    <span class="panel-row-main"><strong>#(template.name)</strong><span>#(template.title)</span></span>
                    #if(template.isDefault):<span class="badge">Default</span>#endif
                    <form method="post" action="/app/boards/#(boardSettings.id)/templates/#(template.id)/use">
                      <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                      <button class="button small" type="submit">Use</button>
                    </form>
                    <form method="post" action="/app/boards/#(boardSettings.id)/templates/#(template.id)/default">
                      <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                      <button class="button ghost small" type="submit">Set default</button>
                    </form>
                    <form method="post" action="/app/boards/#(boardSettings.id)/templates/#(template.id)/delete">
                      <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                      <button class="icon-button" type="submit" aria-label="Delete #(template.name)"><i data-lucide="x"></i></button>
                    </form>
                  </div>
                #endfor
                <form class="panel-row" method="post" action="/app/boards/#(boardSettings.id)/templates">
                  <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                  <input class="input" name="name" placeholder="Template name" required />
                  <input class="input" name="title" placeholder="Default task title" required />
                  <button class="button small" type="submit">Add template</button>
                </form>
              </div>
            </section>

            <section class="section">
              <div class="section-heading"><h2>Data</h2></div>
              <div class="panel">
                <div class="panel-row">
                  <span class="panel-row-main"><strong>Export board</strong><span>Download tasks and configuration as JSON.</span></span>
                  <a class="button" href="/app/boards/#(boardSettings.id)/export"><i data-lucide="download"></i>Export</a>
                </div>
                <form class="panel-row" method="post" action="/app/boards/#(boardSettings.id)/import" enctype="multipart/form-data">
                  <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                  <span class="panel-row-main"><strong>Import board</strong><span>Add tasks from a Flowboard JSON export.</span></span>
                  <label class="button"><i data-lucide="upload"></i>Choose file<input class="sr-only" type="file" name="file" accept="application/json" required /></label>
                  <button class="button" type="submit">Import</button>
                </form>
              </div>
            </section>

            <section class="section">
              <div class="section-heading"><h2>Board actions</h2></div>
              <div class="panel danger-zone">
                <div class="panel-row">
                  <span class="panel-row-main"><strong>#if(boardSettings.isArchived):Restore board#else:Archive board#endif</strong><span>Archived boards leave the main navigation.</span></span>
                  <form method="post" action="/app/boards/#(boardSettings.id)/archive">
                    <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                    <button class="button" type="submit"><i data-lucide="archive"></i>#if(boardSettings.isArchived):Restore#else:Archive#endif</button>
                  </form>
                </div>
                <div class="panel-row">
                  <span class="panel-row-main"><strong>Duplicate board</strong><span>Copy tasks, views, fields, and templates.</span></span>
                  <form method="post" action="/app/boards/#(boardSettings.id)/duplicate">
                    <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                    <button class="button" type="submit"><i data-lucide="copy"></i>Duplicate</button>
                  </form>
                </div>
                #if(boardSettings.isOwner):
                  <div class="panel-row">
                    <span class="panel-row-main"><strong>Delete board</strong><span>Permanently remove this board and its tasks.</span></span>
                    <div data-controller="dialog">
                      <button class="button danger" type="button" data-action="dialog#open">Delete</button>
                      <div
                        class="dialog-layer"
                        data-dialog-target="panel"
                        data-action="click->dialog#backdrop keydown.esc@window->dialog#close"
                        role="dialog"
                        aria-modal="true"
                        aria-labelledby="delete-board-title"
                        tabindex="-1"
                        hidden
                      >
                        <form class="dialog" method="post" action="/app/boards/#(boardSettings.id)/delete">
                          <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                          <div class="dialog-header">
                            <div><h2 id="delete-board-title">Delete #(boardSettings.name)?</h2><p>This action cannot be undone.</p></div>
                          </div>
                          <div class="dialog-footer">
                            <button class="button" type="button" data-action="dialog#close">Cancel</button>
                            <button class="button danger" type="submit">Delete board</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                #endif
              </div>
            </section>
          </div>
        #endif
      </main>
    </div>

    <div
      class="toast"
      data-controller="toast"
      data-action="flowboard:notify@window->toast#show"
      role="status"
      hidden
    ><span data-toast-target="message"></span></div>
  </body>
</html>
