      <aside class="sidebar" data-sidebar-target="panel">
        <div class="brand-row">
          <a class="brand" href="/app" aria-label="Focalboard home">
            <img
              class="brand-logo"
              src="/focalboard-wordmark.webp"
              data-sidebar-target="brandLogo"
              data-wordmark-src="/focalboard-wordmark.webp"
              data-abbreviation-src="/focalboard-fb-abbreviation-tp.webp"
              alt=""
              width="104"
              height="14"
            />
          </a>
        </div>

        <div class="sidebar-section">
          <nav class="main-nav" aria-label="Primary navigation">
            <a class="nav-link#if(isOverview): active#endif" href="/app"#if(isOverview): aria-current="page"#endif title="This week">
              <i data-lucide="calendar-days"></i><span>This week</span>
            </a>
            <a class="nav-link#if(isActiveTasks): active#endif" href="/app/tasks"#if(isActiveTasks): aria-current="page"#endif title="All assignments">
              <i data-lucide="check-square"></i><span>All assignments</span>
            </a>
            <a class="nav-link#if(isArchivedTasks): active#endif" href="/app/tasks/archived"#if(isArchivedTasks): aria-current="page"#endif title="Archived assignments">
              <i data-lucide="archive"></i><span>Archived assignments</span>
            </a>
          </nav>
        </div>

        #if(!isOverview):
        <div class="boards-nav">
          <div class="nav-section-header" data-controller="dialog">
            <span>Courses</span>
            <button
              class="icon-button"
              type="button"
              aria-label="Add course"
              title="Add course"
              data-action="dialog#open"
            ><i data-lucide="plus"></i></button>
            #extend("partials/course-create-dialog")
          </div>
          <nav aria-label="Courses">
            #for(navBoard in common.boards):
              #if(!navBoard.isArchived):
                <a class="nav-link" href="#(navBoard.href)" title="#(navBoard.name)">
                  <i data-lucide="folder"></i>
                  <span>#(navBoard.name)</span>
                  <small>#(navBoard.taskCount)</small>
                </a>
              #endif
            #endfor
          </nav>
        </div>
        #endif

        <div class="sidebar-spacer"></div>
        #extend("partials/build-signature")
        <nav class="settings-nav">
          <a class="nav-link#if(isSettings): active#endif" href="/app/settings"#if(isSettings): aria-current="page"#endif title="Settings">
            <i data-lucide="settings"></i><span>Settings</span>
          </a>
        </nav>
        <a class="user-row" href="/app/settings" title="#(common.userName)">
          <span class="avatar">
            #if(common.userAvatar.hasProfilePicture):
              <img src="#(common.userAvatar.profilePictureURL)" alt="" referrerpolicy="no-referrer" />
            #else:
              #(common.userAvatar.initials)
            #endif
          </span>
          <span>
            <strong>#(common.userName)</strong>
            <small>#(common.userEmail)</small>
          </span>
        </a>
      </aside>

      <button
        class="sidebar-scrim"
        type="button"
        aria-label="Close navigation"
        data-sidebar-target="scrim"
        data-action="sidebar#close"
        hidden
      ></button>
