<a
  class="task-card"
  href="#(href)"
  data-task-id="#(id)"
  data-preview-title="#(title)"
  data-preview-board="#(boardName)"
  data-preview-status="#(statusName)"
  data-preview-status-value="#(statusValue)"
  data-preview-priority="#(priorityName)"
  data-preview-priority-value="#(priorityValue)"
  data-preview-assignee="#(assigneeName)"
  data-preview-due="#(dueDisplay)"
  data-preview-body="#(description)"
>
  <h3>#(title)</h3>
  #if(hasDescription):
    <p>#(description)</p>
  #endif
  <div class="task-meta">
    <span class="badge priority-#(priorityValue)">#(priorityName)</span>
    #for(label in labels):
      <span class="badge subtle">#(label)</span>
    #endfor
    #if(hasDueDate):
      <span class="badge"><i data-lucide="calendar-days"></i>#(dueDisplay)</span>
    #endif
    <span class="task-badges">
      #if(commentCount):
        <span class="task-badge" title="#(commentCount) comments"><i data-lucide="message-square"></i><span class="tabular">#(commentCount)</span></span>
      #endif
      #if(checklistCount):
        <span class="task-badge" title="Checklist"><i data-lucide="list-checks"></i><span class="tabular">#(completedChecklistCount)/#(checklistCount)</span></span>
      #endif
      #if(attachmentCount):
        <span class="task-badge" title="#(attachmentCount) attachments"><i data-lucide="paperclip"></i><span class="tabular">#(attachmentCount)</span></span>
      #endif
    </span>
  </div>
</a>
