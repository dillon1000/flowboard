<!doctype html>
<html lang="en" data-controller="theme">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="csrf-token" content="#(csrfToken)" />
    <title>Create account · Flowboard</title>
    <link rel="icon" href="/favicon.svg" />
    <script>try{const t=localStorage.getItem('flowboard-theme');document.documentElement.dataset.theme=t==='dark'||t==='light'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}catch{}</script>
    <link rel="stylesheet" href="/assets/index.css" />
    <script type="module" src="/assets/app.js"></script>
  </head>
  <body class="auth-page">
    <header class="auth-header">
      <a class="brand" href="/" aria-label="Flowboard home">
        <span class="brand-symbol" aria-hidden="true"></span>
        <span class="brand-name">Flowboard</span>
      </a>
      <button
        class="icon-button"
        type="button"
        data-action="theme#toggle"
        aria-label="Change color theme"
        title="Change color theme"
      >
        <i class="theme-icon-dark" data-lucide="moon"></i>
        <i class="theme-icon-light" data-lucide="sun"></i>
        <span class="sr-only" data-theme-target="label">Use dark theme</span>
      </button>
    </header>

    <main class="auth-main">
      <div class="auth-form-pane">
      <section class="auth-card" aria-labelledby="page-title">
        <h1 id="page-title">Create your account</h1>
        <p>Your workspace and first board are ready after sign-up.</p>

        #if(error):
          <p class="error-message" role="alert">#(error)</p>
        #endif

        #if(oauthEnabled):
          <a class="button large block oauth-button" href="/oauth/start">
            <i data-lucide="log-in"></i>
            Continue with #(oauthProviderName)
          </a>
          <div class="auth-divider" aria-hidden="true"><span>or</span></div>
        #endif

        <form method="post" action="/register">
          <input type="hidden" name="_csrf" value="#(csrfToken)" />
          <div class="field">
            <label for="name">Name</label>
            <input
              class="input"
              id="name"
              type="text"
              name="name"
              autocomplete="name"
              placeholder="Your name"
              minlength="2"
              maxlength="80"
              required
              autofocus
            />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input
              class="input"
              id="email"
              type="email"
              name="email"
              value="#(email)"
              autocomplete="email"
              spellcheck="false"
              placeholder="you@example.com"
              required
            />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input
              class="input"
              id="password"
              type="password"
              name="password"
              autocomplete="new-password"
              placeholder="At least 8 characters"
              minlength="8"
              maxlength="72"
              required
            />
            <span class="field-help">Use 8 to 72 characters.</span>
          </div>
          <button class="button primary" type="submit">Create account</button>
        </form>

        <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
      </section>
      </div>

      <aside class="auth-aside">
        <blockquote>Everything your team needs to ship the work.</blockquote>
        <ul class="auth-points">
          <li><i data-lucide="columns-3"></i>Board, table, calendar, and gallery views</li>
          <li><i data-lucide="users"></i>Shared boards with per-role access</li>
          <li><i data-lucide="copy"></i>Templates, custom fields, and JSON export</li>
        </ul>
        <p class="auth-footer">Your work stays private until you share it.</p>
      </aside>
    </main>
  </body>
</html>
