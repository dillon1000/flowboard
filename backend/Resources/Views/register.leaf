<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>Create Account · Flowboard</title>
    <link rel="stylesheet" href="/auth.css" />
  </head>
  <body>
    <main class="auth-shell">
      <a class="auth-brand" href="/" aria-label="Flowboard home">
        <span class="brand-symbol" aria-hidden="true"></span>
        Flowboard
      </a>

      <section class="auth-card" aria-labelledby="page-title">
        <header>
          <h1 id="page-title">Create your account</h1>
          <p>Your first board is ready when you sign up.</p>
        </header>

        #if(error):
          <p class="form-message">#(error)</p>
        #endif

        <form method="post" action="/register">
          <label>
            Name
            <input
              type="text"
              name="name"
              autocomplete="name"
              placeholder="Your name"
              minlength="2"
              maxlength="80"
              required
              autofocus
            />
          </label>
          <label>
            Email
            <input
              type="email"
              name="email"
              value="#(email)"
              autocomplete="email"
              spellcheck="false"
              placeholder="you@example.com"
              required
            />
          </label>
          <label>
            Password
            <input
              type="password"
              name="password"
              autocomplete="new-password"
              placeholder="At least 8 characters"
              minlength="8"
              maxlength="72"
              required
            />
          </label>
          <button type="submit">Create Account</button>
        </form>

        <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
      </section>
    </main>
  </body>
</html>
