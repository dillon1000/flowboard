<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <title>Tap action · Flowboard</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script>try{const t=localStorage.getItem('flowboard-theme');document.documentElement.dataset.theme=t==='dark'||t==='light'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}catch{}</script>
    <style>
      :root {
        color-scheme: light;
        --surface: #fff;
        --surface-sunken: #fafafa;
        --surface-hover: hsl(0deg 0% 95%);
        --text: hsl(0deg 0% 9%);
        --text-secondary: hsl(0deg 0% 40%);
        --text-tertiary: hsl(0deg 0% 56%);
        --border: rgb(0 0 0 / 8%);
        --border-strong: rgb(0 0 0 / 21%);
        --green-surface: hsl(120deg 60% 95%);
        --green-text: hsl(133deg 50% 32%);
        --red-surface: hsl(0deg 100% 96%);
        --red-text: hsl(358deg 66% 48%);
        --focus: hsl(211deg 100% 42%);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-synthesis: none;
        text-rendering: optimizelegibility;
        -webkit-font-smoothing: antialiased;
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --surface: #0a0a0a;
        --surface-sunken: hsl(0deg 0% 7%);
        --surface-hover: hsl(0deg 0% 12%);
        --text: hsl(0deg 0% 93%);
        --text-secondary: hsl(0deg 0% 63%);
        --text-tertiary: hsl(0deg 0% 56%);
        --border: rgb(255 255 255 / 14%);
        --border-strong: rgb(255 255 255 / 24%);
        --green-surface: hsl(137deg 50% 12%);
        --green-text: hsl(131deg 43% 57%);
        --red-surface: hsl(357deg 46% 16%);
        --red-text: hsl(358deg 100% 69%);
        --focus: hsl(210deg 100% 66%);
      }

      *, *::before, *::after { box-sizing: border-box; }

      html { min-width: 320px; background: var(--surface); -webkit-text-size-adjust: 100%; }

      body {
        display: grid;
        min-width: 320px;
        min-height: 100dvh;
        grid-template-rows: 64px 1fr;
        margin: 0;
        color: var(--text);
        background: var(--surface);
        font-size: 14px;
        line-height: 1.5;
      }

      .tap-header {
        display: flex;
        height: 64px;
        align-items: center;
        padding: 0 24px;
      }

      .brand {
        display: inline-flex;
        min-height: 40px;
        align-items: center;
        gap: 9px;
        color: var(--text);
        font-size: 14px;
        font-weight: 600;
        letter-spacing: -.02em;
        text-decoration: none;
      }

      .brand-mark {
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        border-radius: 6px;
        background: var(--text);
      }

      .brand-mark::after {
        width: 0;
        height: 0;
        border-right: 6px solid transparent;
        border-bottom: 11px solid var(--surface);
        border-left: 6px solid transparent;
        content: "";
      }

      main {
        display: grid;
        place-items: center;
        padding: 40px 24px 104px;
      }

      .tap-card { width: min(100%, 360px); }

      .state-icon {
        display: grid;
        width: 48px;
        height: 48px;
        margin-bottom: 24px;
        place-items: center;
        border-radius: 12px;
        background: var(--surface-sunken);
        box-shadow: 0 0 0 1px var(--border);
      }

      .spinner {
        width: 18px;
        height: 18px;
        border: 2px solid var(--border-strong);
        border-top-color: var(--text);
        border-radius: 50%;
        animation: spin .7s linear infinite;
      }

      .check,
      .state-art { display: none; }

      .check {
        color: var(--green-text);
        font-size: 21px;
        font-weight: 600;
        line-height: 1;
      }

      .state-art { width: 30px; height: 30px; object-fit: contain; }

      .tap-card[data-state="success"] .state-icon { background: var(--green-surface); }
      .tap-card[data-state="success"] .spinner { display: none; }
      .tap-card[data-state="success"] .check { display: block; }

      .tap-card[data-state="error"] .state-icon,
      .tap-card[data-state="rotation"] .state-icon { background: #1a1a1a; }
      .tap-card[data-state="error"] .spinner,
      .tap-card[data-state="rotation"] .spinner { display: none; }
      .tap-card[data-state="error"] .state-art,
      .tap-card[data-state="rotation"] .state-art { display: block; }

      .state-label {
        margin: 0 0 8px;
        color: var(--text-tertiary);
        font-size: 12px;
        font-weight: 500;
      }

      h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
        letter-spacing: -.03em;
        line-height: 1.2;
        text-wrap: balance;
      }

      .message {
        margin: 10px 0 0;
        color: var(--text-secondary);
        font-size: 14px;
        line-height: 1.55;
        white-space: pre-wrap;
      }

      .result {
        margin: 24px 0 0;
        padding: 11px 12px;
        border-radius: 8px;
        color: var(--green-text);
        background: var(--green-surface);
        box-shadow: 0 0 0 1px color-mix(in srgb, var(--green-text) 18%, transparent);
        font-size: 13px;
        font-weight: 500;
      }

      button {
        display: inline-flex;
        height: 40px;
        align-items: center;
        justify-content: center;
        margin-top: 24px;
        padding: 0 16px;
        border: 0;
        border-radius: 6px;
        color: var(--surface);
        background: var(--text);
        cursor: pointer;
        font: inherit;
        font-size: 14px;
        font-weight: 500;
        line-height: 1;
      }

      button:hover { opacity: .88; }
      button:active { opacity: .8; }
      button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
      [hidden] { display: none !important; }

      @keyframes spin { to { transform: rotate(360deg); } }

      @media (width <= 480px) {
        .tap-header { padding: 0 16px; }
        main { align-items: start; padding: min(18vh, 112px) 20px 64px; }
      }

      @media (prefers-reduced-motion: reduce) {
        .spinner { animation-duration: 1.4s; }
      }
    </style>
  </head>
  <body>
    <header class="tap-header">
      <a class="brand" href="/" aria-label="Flowboard home"><span class="brand-mark" aria-hidden="true"></span>Flowboard</a>
    </header>
    <main>
      <section class="tap-card" id="tap" data-state="running" aria-live="polite" aria-labelledby="title">
        <div class="state-icon" aria-hidden="true">
          <span class="spinner"></span>
          <span class="check">✓</span>
          <img class="state-art" id="state-art" alt="" />
        </div>
        <p class="state-label" id="state-label">Tap action</p>
        <h1 id="title">Running action…</h1>
        <p class="message" id="message">Keep this page open.</p>
        <p class="result" id="result" hidden></p>
        <button id="retry" type="button" hidden>Try again</button>
        <noscript><p class="message">JavaScript is required to run this Tap action.</p></noscript>
      </section>
    </main>
    <script>
      (() => {
        const token = location.hash.slice(1);
        history.replaceState(null, '', location.pathname + location.search);
        const tap = document.getElementById('tap');
        const label = document.getElementById('state-label');
        const title = document.getElementById('title');
        const message = document.getElementById('message');
        const result = document.getElementById('result');
        const retry = document.getElementById('retry');
        const art = document.getElementById('state-art');
        const requestID = crypto.randomUUID();

        const render = (state, heading, detail, outcome = '', canRetry = false, asset = '') => {
          tap.dataset.state = state;
          label.textContent = state === 'success' ? 'Action complete' : state === 'running' ? 'Tap action' : 'Tap action stopped';
          title.textContent = heading;
          message.textContent = detail;
          message.hidden = !detail;
          result.textContent = outcome;
          result.hidden = !outcome;
          retry.hidden = !canRetry;
          if (asset) art.src = asset;
          else art.removeAttribute('src');
        };

        const execute = async () => {
          render('running', 'Running action…', 'Keep this page open.');
          try {
            const response = await fetch('/api/v1/taps/execute', {
              method: 'POST',
              credentials: 'omit',
              cache: 'no-store',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ token, requestID }),
            });
            const body = await response.json().catch(() => ({}));
            if (!response.ok) {
              const detail = typeof body.reason === 'string' ? body.reason : 'This Tap action could not run.';
              if (response.status === 404) {
                render('rotation', 'This Tap link is not valid', 'Ask the tag owner to program it again.', '', false, '/tagneedsrotation.svg');
              } else if (response.status === 410) {
                render('rotation', 'This Tap action is unavailable', detail, '', false, '/tagneedsrotation.svg');
              } else {
                const canRetry = response.status === 429 || response.status >= 500;
                render('error', response.status === 429 ? 'Try again in a moment' : 'The action could not run', detail, '', canRetry, '/scanerror.svg');
              }
              return;
            }
            const heading = typeof body.actionName === 'string' ? body.actionName : 'Action complete';
            const detail = typeof body.actionDescription === 'string' && body.actionDescription.trim()
              ? body.actionDescription
              : 'The Tap action is complete.';
            const outcome = typeof body.message === 'string' ? body.message : 'Done.';
            render('success', heading, detail, outcome);
          } catch {
            render('error', 'Flowboard could not be reached', 'Check the network, then try again.', '', true, '/scanerror.svg');
          }
        };

        retry.addEventListener('click', execute);
        if (!/^fbt_[A-Za-z0-9_-]{32}$/.test(token)) {
          render('rotation', 'This Tap link is not valid', 'Ask the tag owner to program it again.', '', false, '/tagneedsrotation.svg');
          return;
        }
        execute();
      })();
    </script>
  </body>
</html>
