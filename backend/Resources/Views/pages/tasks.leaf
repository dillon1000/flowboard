        #if(isTasks):
          <div class="page">
            <header class="page-header">
              <div class="page-title">
                <h1>#if(isArchivedTasks):Archived assignments#else:#if(tasks.query):Search results#else:All assignments#endif#endif</h1>
                <p>#if(isArchivedTasks):Restore assignments that you want to plan again.#else:#if(tasks.query):Assignments matching “#(tasks.query)”.#else:Every active assignment across your courses.#endif#endif</p>
              </div>
              <div class="page-actions">
                #if(isArchivedTasks):
                  <a class="button" href="/app/tasks"><i data-lucide="check-square"></i>All assignments</a>
                #else:
                  <a class="button" href="/app/tasks/archived"><i data-lucide="archive"></i>Archived assignments</a>
                #endif
              </div>
            </header>
            #if(tasks.hasTasks):
              <div class="table-wrap">
                <table class="data-table">
                  <thead><tr><th>Assignment</th><th>Course</th><th>Status</th><th>Severity</th><th>Assignee</th><th>Due</th>#if(isArchivedTasks):<th>Action</th>#endif</tr></thead>
                  <tbody>
                    #for(task in tasks.tasks):
                      <tr
                        data-preview-title="#(task.title)"
                        data-preview-board="#(task.boardName)"
                        data-preview-status="#(task.statusName)"
                        data-preview-status-value="#(task.statusValue)"
                        data-preview-status-class="#(task.statusColorClass)"
                        data-preview-status-color="#(task.statusCustomColor)"
                        data-preview-priority="#(task.priorityName)"
                        data-preview-priority-value="#(task.priorityValue)"
                        data-preview-priority-class="#(task.priorityColorClass)"
                        data-preview-priority-color="#(task.priorityCustomColor)"
                        data-preview-assignee="#(task.assigneeName)"
                        data-preview-due="#(task.dueDisplay)"
                        data-preview-body="#(task.description)"
                      >
                        <td><a href="#(task.href)">#(task.title)</a></td>
                        <td>#(task.boardName)</td>
                        <td><span class="badge status #(task.statusColorClass)" style="#(task.statusColorStyle)">#(task.statusName)</span></td>
                        <td><span class="badge #(task.priorityColorClass)" style="#(task.priorityColorStyle)">#(task.priorityName)</span></td>
                        <td#if(!task.hasAssignee): class="muted"#endif>#(task.assigneeName)</td>
                        <td#if(!task.hasDueDate): class="muted"#endif>#(task.dueDisplay)</td>
                        #if(isArchivedTasks):
                          <td>
                            #if(task.canEdit):
                              <form method="post" action="/app/tasks/#(task.id)/archive">
                                <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                                <button class="button small" type="submit">Restore</button>
                              </form>
                            #else:
                              <span class="muted">View only</span>
                            #endif
                          </td>
                        #endif
                      </tr>
                    #endfor
                  </tbody>
                </table>
              </div>
            #else:
              <div class="empty-state">
                <div>
                  <span class="empty-state-icon" aria-hidden="true"><i data-lucide="#if(isArchivedTasks):archive#else:search#endif"></i></span>
                  <h2>#if(isArchivedTasks):No archived assignments#else:No assignments found#endif</h2>
                  <p>#if(isArchivedTasks):Assignments that you archive will appear here.#else:Try a different search, or add an assignment from this week.#endif</p>
                </div>
              </div>
            #endif
          </div>
        #endif
