        #if(isBoard):
          <div class="page framed">
            <div class="board-bar">
            <header class="page-header">
              <div class="page-title">
                <h1>#(board.name)</h1>
                <p>#if(board.description):#(board.description)#else:Shared as #(board.role).#endif</p>
              </div>
              <div class="page-actions">
                <a class="button" href="/app/boards/#(board.id)/settings"><i data-lucide="settings"></i>Board settings</a>
                #if(board.canEdit):
                  <div data-controller="dialog">
                    <button class="button primary" type="button" data-action="dialog#open">
                      <i data-lucide="plus"></i>New task
                    </button>
                    <div
                      class="dialog-layer"
                      data-dialog-target="panel"
                      data-action="click->dialog#backdrop keydown.esc@window->dialog#close"
                      role="dialog"
                      aria-modal="true"
                      aria-labelledby="new-task-title"
                      tabindex="-1"
                      hidden
                    >
                      <form class="dialog wide" method="post" action="/app/tasks">
                        <input type="hidden" name="_csrf" value="#(common.csrfToken)" />
                        <input type="hidden" name="boardID" value="#(board.id)" />
                        <input type="hidden" name="returnTo" value="#(board.activeView.href)" />
                        <div class="dialog-header">
                          <div><h2 id="new-task-title">Create task</h2><p>#if(board.hasDefaultTemplate):Using the #(board.defaultTemplateName) template.#else:Add the work, then refine its details.#endif</p></div>
                          <button class="icon-button" type="button" data-action="dialog#close" aria-label="Close"><i data-lucide="x"></i></button>
                        </div>
                        <div class="dialog-body">
                          <div class="form-grid">
                            <div class="field wide">
                              <label for="new-task-name">Title</label>
                              <input class="input" id="new-task-name" name="title" value="#(board.newTaskTitle)" maxlength="120" required data-dialog-target="initial" />
                            </div>
                            <div class="field wide">
                              <label for="new-task-description">Description</label>
                              <textarea class="textarea" id="new-task-description" name="description" maxlength="5000">#(board.newTaskDescription)</textarea>
                            </div>
                            <div class="field">
                              <span class="field-label">Status</span>
                              <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                                <input data-menu-target="input" type="hidden" name="status" value="#(board.newTaskStatus)" />
                                <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                                  <span data-menu-target="value">#(board.newTaskStatusName)</span><i data-lucide="chevron-down"></i>
                                </button>
                                <div class="menu-panel" data-menu-target="panel" role="listbox" hidden>
                                  #for(option in board.statusOptions):
                                    <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="#(option.value)" data-label="#(option.name)" aria-selected="#(option.isSelected)">#(option.name)</button>
                                  #endfor
                                </div>
                              </div>
                            </div>
                            <div class="field">
                              <span class="field-label">Severity</span>
                              <div class="menu" data-controller="menu" data-action="click@window->menu#outside keydown.esc@window->menu#close">
                                <input data-menu-target="input" type="hidden" name="priority" value="#(board.newTaskPriority)" />
                                <button class="select-trigger" type="button" data-menu-target="trigger" data-action="menu#toggle" aria-expanded="false">
                                  <span data-menu-target="value">#(board.newTaskPriorityName)</span><i data-lucide="chevron-down"></i>
                                </button>
                                <div class="menu-panel" data-menu-target="panel" role="listbox" hidden>
                                  #for(option in board.severityOptions):
                                    <button class="menu-option" type="button" data-menu-target="option" data-action="menu#choose" data-value="#(option.value)" data-label="#(option.name)" aria-selected="#(option.isSelected)">#(option.name)</button>
                                  #endfor
                                </div>
                              </div>
                            </div>
                            <div class="field" data-controller="date-picker">
                              <label for="new-task-start">Start date</label>
                              <input class="input" id="new-task-start" name="startAt" data-date-picker-target="input" />
                            </div>
                            <div class="field" data-controller="date-picker">
                              <label for="new-task-due">Due date</label>
                              <input class="input" id="new-task-due" name="dueAt" data-date-picker-target="input" />
                            </div>
                            <div class="field wide">
                              <label for="new-task-labels">Labels</label>
                              <input class="input" id="new-task-labels" name="labels" value="#(board.newTaskLabels)" placeholder="Design, Launch" />
                            </div>
                          </div>
                        </div>
                        <div class="dialog-footer">
                          <button class="button" type="button" data-action="dialog#close">Cancel</button>
                          <button class="button primary" type="submit">Create task</button>
                        </div>
                      </form>
                    </div>
                  </div>
                #endif
              </div>
            </header>

            <nav class="board-toolbar" aria-label="Board views">
              #for(view in board.views):
                <a class="view-tab#if(view.isActive): active#endif" href="#(view.href)">
                  <i data-lucide="#(view.icon)"></i>#(view.name)
                </a>
              #endfor
              <span class="toolbar-spacer"></span>
              <span class="badge subtle">Group: #(board.groupByName)</span>
              #if(board.hasFilters):<span class="badge subtle"><i data-lucide="filter"></i>#(board.filterSummary)</span>#endif
              #if(board.hasSorts):<span class="badge subtle"><i data-lucide="arrow-down-up"></i>#(board.sortSummary)</span>#endif
              <a class="button ghost small" href="/app/boards/#(board.id)/settings"><i data-lucide="settings"></i>Configure</a>
            </nav>
            </div>

            <div class="board-canvas#if(board.activeView.isBoard): flush#endif">
            #if(board.activeView.isBoard):
              <div class="kanban" data-controller="board" data-board-editable-value="#(board.canDrag)">
                #for(column in board.columns):
                  <section class="kanban-column">
                    <header class="column-header">
                      <span class="column-dot #(column.dotClass)" style="#(column.dotStyle)" aria-hidden="true"></span>
                      <strong>#(column.name)</strong>
                      <span class="count">#(column.count)</span>
                    </header>
                    <div class="column-tasks" data-board-target="column" data-status="#(column.value)" data-completed="#(column.isCompleted)">
                      #for(task in column.tasks):
                        #extend("partials/task-card", task)
                      #endfor
                    </div>
                  </section>
                #endfor
              </div>
            #endif

            #if(board.activeView.isTable):
              #if(board.hasTasks):
                <div class="table-wrap">
                  <table class="data-table">
                    <thead><tr><th>Task</th><th>Status</th><th>Severity</th><th>Assignee</th><th>Start</th><th>Due</th></tr></thead>
                    <tbody>
                      #for(task in board.tasks):
                        <tr
                          data-preview-title="#(task.title)"
                          data-preview-board="#(board.name)"
                          data-preview-status="#(task.statusName)"
                          data-preview-status-value="#(task.statusValue)"
                          data-preview-status-class="#(task.statusColorClass)"
                          data-preview-status-color="#(task.statusCustomColor)"
                          data-preview-priority="#(task.priorityName)"
                          data-preview-priority-value="#(task.priorityValue)"
                          data-preview-priority-class="#(task.priorityColorClass)"
                          data-preview-priority-color="#(task.priorityCustomColor)"
                          data-preview-assignee="#(task.assigneeName)"
                          data-preview-due="#(task.dueDisplay)"
                          data-preview-body="#(task.description)"
                        >
                          <td><a href="#(task.href)">#(task.title)</a></td>
                          <td><span class="badge status #(task.statusColorClass)" style="#(task.statusColorStyle)">#(task.statusName)</span></td>
                          <td><span class="badge #(task.priorityColorClass)" style="#(task.priorityColorStyle)">#(task.priorityName)</span></td>
                          <td#if(!task.hasAssignee): class="muted"#endif>#(task.assigneeName)</td>
                          <td class="muted">#(task.startDisplay)</td>
                          <td#if(!task.hasDueDate): class="muted"#endif>#(task.dueDisplay)</td>
                        </tr>
                      #endfor
                    </tbody>
                  </table>
                </div>
              #else:
                <div class="empty-state">
                  <div>
                    <span class="empty-state-icon" aria-hidden="true"><i data-lucide="table-2"></i></span>
                    <h2>No tasks in this view</h2>
                    <p>Create a task, or loosen this view’s filters in board settings.</p>
                  </div>
                </div>
              #endif
            #endif

            #if(board.activeView.isCalendar):
              <div class="calendar-shell">
                <div class="calendar-toolbar">
                  <div class="calendar-navigation">
                    <a class="icon-button" href="#(board.previousMonthHref)" aria-label="Previous month"><i data-lucide="chevron-left"></i></a>
                    <h2>#(board.calendarMonthLabel)</h2>
                    <a class="icon-button" href="#(board.nextMonthHref)" aria-label="Next month"><i data-lucide="chevron-right"></i></a>
                  </div>
                  <a class="button small" href="#(board.todayMonthHref)">Today</a>
                </div>
                <div class="calendar-weekdays"><div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div></div>
                <div class="calendar-grid">
                  #for(day in board.calendarDays):
                    <div class="calendar-day#if(day.isMuted): muted#endif#if(day.isToday): today#endif">
                      <span class="calendar-date">#(day.day)</span>
                      #for(task in day.tasks):
                        <a
                          class="calendar-task #(task.statusColorClass)"
                          style="#(task.statusColorStyle)"
                          href="#(task.href)"
                          data-preview-title="#(task.title)"
                          data-preview-board="#(board.name)"
                          data-preview-status="#(task.statusName)"
                          data-preview-status-value="#(task.statusValue)"
                          data-preview-status-class="#(task.statusColorClass)"
                          data-preview-status-color="#(task.statusCustomColor)"
                          data-preview-priority="#(task.priorityName)"
                          data-preview-priority-value="#(task.priorityValue)"
                          data-preview-priority-class="#(task.priorityColorClass)"
                          data-preview-priority-color="#(task.priorityCustomColor)"
                          data-preview-assignee="#(task.assigneeName)"
                          data-preview-due="#(task.dueDisplay)"
                          data-preview-body="#(task.description)"
                        ><span>#(task.title)</span></a>
                      #endfor
                    </div>
                  #endfor
                </div>
              </div>
            #endif

            #if(board.activeView.isGallery):
              #if(board.hasTasks):
                <div class="gallery">
                  #for(task in board.tasks):
                    <a
                      class="gallery-card"
                      href="#(task.href)"
                      data-preview-title="#(task.title)"
                      data-preview-board="#(board.name)"
                      data-preview-status="#(task.statusName)"
                      data-preview-status-value="#(task.statusValue)"
                      data-preview-status-class="#(task.statusColorClass)"
                      data-preview-status-color="#(task.statusCustomColor)"
                      data-preview-priority="#(task.priorityName)"
                      data-preview-priority-value="#(task.priorityValue)"
                      data-preview-priority-class="#(task.priorityColorClass)"
                      data-preview-priority-color="#(task.priorityCustomColor)"
                      data-preview-assignee="#(task.assigneeName)"
                      data-preview-due="#(task.dueDisplay)"
                      data-preview-body="#(task.description)"
                    >
                      <h3>#(task.title)</h3>
                      <p>#if(task.hasDescription):#(task.description)#else:No description.#endif</p>
                      <div class="task-meta">
                        <span class="badge status #(task.statusColorClass)" style="#(task.statusColorStyle)">#(task.statusName)</span>
                        <span class="badge #(task.priorityColorClass)" style="#(task.priorityColorStyle)">#(task.priorityName)</span>
                      </div>
                    </a>
                  #endfor
                </div>
              #else:
                <div class="empty-state">
                  <div>
                    <span class="empty-state-icon" aria-hidden="true"><i data-lucide="gallery-horizontal-end"></i></span>
                    <h2>No tasks in this view</h2>
                    <p>Create a task, or loosen this view’s filters in board settings.</p>
                  </div>
                </div>
              #endif
            #endif
            </div>
          </div>
        #endif
