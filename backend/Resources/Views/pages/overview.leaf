        #if(isOverview):
          <div class="page">
            <header class="page-header">
              <div class="page-title">
                <h1>Overview</h1>
                <p>Boards, deadlines, and recent work in one place.</p>
              </div>
            </header>

            <section class="stats" aria-label="Workspace summary">
              <div class="stat">
                <span><i data-lucide="check-square"></i>Open tasks</span>
                <strong>#(overview.totalTasks)</strong>
              </div>
              <div class="stat">
                <span><i data-lucide="check"></i>Completed</span>
                <strong>#(overview.completedTasks)</strong>
              </div>
              <div class="stat">
                <span><i data-lucide="calendar-days"></i>With due dates</span>
                <strong>#(overview.dueTasks)</strong>
              </div>
              <div class="stat">
                <span><i data-lucide="folder"></i>Active boards</span>
                <strong>#(overview.boardCount)</strong>
              </div>
            </section>

            <div class="overview-grid">
            <section class="section">
              <div class="section-heading">
                <div>
                  <h2>Boards</h2>
                  <p>Every board you own or have been given access to.</p>
                </div>
              </div>
              <div class="board-list">
                #for(navBoard in common.boards):
                  #if(!navBoard.isArchived):
                    <a class="board-card" href="#(navBoard.href)">
                      <span class="board-card-head">
                        <span class="board-card-icon" aria-hidden="true"><i data-lucide="folder"></i></span>
                        <h3>#(navBoard.name)</h3>
                      </span>
                      <p>#(navBoard.description)</p>
                      <span class="board-card-meta">
                        <span><i data-lucide="check-square"></i><span class="tabular">#(navBoard.taskCount)</span> tasks</span>
                        <span><i data-lucide="check"></i><span class="tabular">#(navBoard.completedCount)</span> done</span>
                      </span>
                    </a>
                  #endif
                #endfor
              </div>
            </section>

            <section class="section overview-rail">
              <div class="section-heading">
                <div>
                  <h2>Recent tasks</h2>
                </div>
                <a class="button small" href="/app/tasks">View all</a>
              </div>
              #if(overview.hasRecentTasks):
                <div class="panel">
                  #for(task in overview.recentTasks):
                    <a
                      class="panel-row"
                      href="#(task.href)"
                      data-preview-title="#(task.title)"
                      data-preview-board="#(task.boardName)"
                      data-preview-status="#(task.statusName)"
                      data-preview-status-value="#(task.statusValue)"
                      data-preview-status-class="#(task.statusColorClass)"
                      data-preview-status-color="#(task.statusCustomColor)"
                      data-preview-priority="#(task.priorityName)"
                      data-preview-priority-value="#(task.priorityValue)"
                      data-preview-priority-class="#(task.priorityColorClass)"
                      data-preview-priority-color="#(task.priorityCustomColor)"
                      data-preview-assignee="#(task.assigneeName)"
                      data-preview-due="#(task.dueDisplay)"
                      data-preview-body="#(task.description)"
                    >
                      <span class="panel-row-main">
                        <strong>#(task.title)</strong>
                        <span>#(task.boardName) · #(task.updatedDisplay)</span>
                      </span>
                      <span class="badge status #(task.statusColorClass)" style="#(task.statusColorStyle)">#(task.statusName)</span>
                    </a>
                  #endfor
                </div>
              #else:
                <div class="empty-state">
                  <div>
                    <span class="empty-state-icon" aria-hidden="true"><i data-lucide="check-square"></i></span>
                    <h2>No tasks yet</h2>
                    <p>Open a board and create the first task to see recent activity here.</p>
                  </div>
                </div>
              #endif
            </section>
            </div>
          </div>
        #endif
