        #if(isTaskDetail):
          <div
            class="page"
            data-controller="task-page"
            data-task-id="#(taskDetail.task.id)"
            data-action="turbo:render@document->task-page#refresh"
          >
            #extend("partials/task-detail-header")
            <div class="split-layout">
              <article class="task-main">
                #extend("partials/task-detail-content")
              </article>
              #extend("partials/task-detail-sidebar")
            </div>
          </div>
        #endif
