.DS_Store
.git
.gitignore

# Keep local dependencies and generated build output out of the remote build context.
frontend/node_modules
frontend/dist
frontend/.svelte-kit
frontend/build
frontend/.playwright-cli
backend/.build
backend/.swiftpm

# Never send local credentials or persistent application data to the image builder.
backend/.env
backend/db.sqlite*
backend/Uploads
work
